POSTGRES_DB=smart_energy
POSTGRES_USER=smart_energy
POSTGRES_PASSWORD=smart_energy
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=5173
# Use `fixture` for synthetic local smoke tests, `cer-dev` for sampled approved CER data,
# or `smart-meters` for the London smart-meter dataset workflow.
APP_PROFILE=fixture
# For `cer-dev` or `cer-full`, point this at the approved CER export mounted into the trainer.
RAW_DATA_DIR=./data/raw
# For `smart-meters`, point this at the smart meter dataset root containing
# `informations_households.csv` and `halfhourly_dataset/`.
SMART_METER_DATA_DIR=./data/artifacts/datasets/smart-meters
# Optional: authorized ISSDA Dataverse API key for `download-cer`.
ISSDA_DATAVERSE_API_KEY=
FIXTURE_DATA_DIR=./data/fixture
ARTIFACTS_DIR=./data/artifacts
SYNTHETIC_DATASET_HOUSEHOLDS=96
SYNTHETIC_DATASET_DAYS=365
SYNTHETIC_DATASET_SEED=42
OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
TRAINER_DEVICE=auto
JWT_SECRET_KEY=change-me-change-me-change-me-32b
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440
